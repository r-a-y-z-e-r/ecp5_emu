    {
      "label": "header_pulls",
      "design": "header_probe_driven",
      "script": "tools/window_record/header_probe.script",
      "prepare": {
        "command": [
          "examples/ulx3s/build.sh",
          "examples/ulx3s/header_probe/driven",
          "target/reference/header_probe_driven"
