    {
      "label": "v010_new_project",
      "project": "examples/ulx3s/blinky_cycle",
      "script": "tools/gui_scripts/v010/new_project.window.script",
      "timeout": 300,
      "criteria": [
        {
          "check": "note",
          "source": "both",
          "pattern": "new-project cancelled",
          "min": 2
        },
        {
          "check": "note",
          "source": "window",
          "pattern": "^# new-project \"My counter #1\" ok [0-9]+\\.[0-9]{3}$",
          "min": 1
        },
        {
          "check": "note",
          "source": "project",
          "pattern": "^new-project \"My counter #1\" ok [0-9]+\\.[0-9]{3}$",
          "min": 1
        },
        {
          "check": "note",
          "source": "project",
          "pattern": "^project My counter #1 \\.$",
          "min": 1
        },
        {
          "check": "note",
          "source": "project",
          "pattern": "^open top\\.v:1 language=verilog$",
          "min": 1
        },
        {
          "check": "note",
          "source": "project",
          "pattern": "\\A(?![\\s\\S]*build start)[\\s\\S]*\\Z",
          "min": 1
        },
        {
          "check": "note",
          "source": "both",
          "pattern": "copy-demo ulx3s/uart_hello \"My UART\" ok ",
          "min": 2
        },
        {
          "check": "no_home"
        },
        {
          "check": "no_error"
        }
      ]
    }
  ]
