  "open_questions": [
    {
      "id": "L01",
      "question": "Datasheet PDPR16x4 requires six slices, while nextpnr packs independent read/write addresses into one three-slice PLC memory structure; measure the actual construction and distinguish primitive/IP semantics."
    },
    {
      "id": "L02",
      "question": "Available FF and extended-mux functions during RAMW/DPRAM, and behavior of nonstandard mixed mode settings."
    },
    {
      "id": "L03",
      "question": "Physical read-during-write, simultaneous observation and unknown-address/enable behavior; public models alone are not a silicon oracle."
    },
    {
      "id": "L04",
      "question": "INIT, configuration startup, GSR/local reset and retention of the LUTRAM array versus surrounding FF."
    },
    {
      "id": "L05",
      "question": "Physical constraints of shared CLK1/LSR1, inversion and separate FF clock/reset selections versus conservative packing rules."
    },
    {
      "id": "L06",
      "question": "Mode-qualified output mux and carry/LUT-extension behavior for overlapping control patterns, including chain boundaries."
    },
    {
      "id": "L07",
      "question": "Confirm all 16 initialized addresses on hardware while retaining the known legacy software initialization hole as a separate issue."
    },
    {
      "id": "L08",
      "question": "Confirm logical address, INIT permutation and live-write correspondence on native LUT contacts without applying routing-tool permutations twice."
    },
    {
      "id": "L09",
      "question": "The datasheet mentions level-sensitive registers, but the current PLC2 settings and inspected TRELLIS_FF model do not establish their configuration; investigate before excluding latch behavior."
    }
  ]
