+/* Called only by a branch actually evaluated; never index a LUT with X. */
+static inline u8 fast_ebr_read(u8 *v, uint32_t slot, uint32_t unit) {{
+  if (v[slot] > 1) {{
+    u8 expected = 0;
+    /* One winning reporter; the caller reads after the settle pool joins. */
+    if (__atomic_compare_exchange_n(&v[{error_slot}], &expected, 255, 0,
+                                   __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {{
+      v[{error_unit_lo}] = (u8)unit;
+      v[{error_unit_hi}] = (u8)(unit >> 8);
+      __atomic_store_n(&v[{error_slot}], 2, __ATOMIC_RELEASE);
+    }}
+    return 0;
+  }}
+  return v[slot];
+}}
