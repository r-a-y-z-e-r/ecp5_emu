+// Checked reads stay inside C conditional branches. Unknown EBR values
+// never become Boolean truth or a LUT shift/index before the diagnostic.
+fn ebr_read(t: Term, ebr: &HashMap<usize, usize>) -> String {
+    match t {
+        Term::Net { slot, inverted } if ebr.contains_key(&slot) => format!(
+            "(fast_ebr_read(v, {slot}, {}) ^ {})",
+            ebr[&slot],
+            u8::from(inverted)
+        ),
+        _ => t.c(),
+    }
+}
+
+fn ebr_lut(init: u16, t: &[Term; 4], ebr: &HashMap<usize, usize>) -> String {
+    let mut leaves: Vec<usize> = t
+        .iter()
+        .filter_map(|t| match t {
+            Term::Net { slot, .. } => Some(*slot),
+            _ => None,
+        })
+        .collect();
+    leaves.sort_unstable_by_key(|s| (ebr.contains_key(s), *s));
+    leaves.dedup();
+    fn branch(
+        f: &LineFn,
+        leaves: &[usize],
+        depth: usize,
+        bits: usize,
+        ebr: &HashMap<usize, usize>,
+    ) -> String {
+        if depth == leaves.len() {
+            return u8::from(
+                f.eval(&|s| bits & (1 << leaves.iter().position(|&x| x == s).unwrap()) != 0),
+            )
+            .to_string();
+        }
+        let low = branch(f, leaves, depth + 1, bits, ebr);
+        let high = branch(f, leaves, depth + 1, bits | (1 << depth), ebr);
+        if low == high {
+            return low;
+        }
+        let read = ebr_read(
+            Term::Net {
+                slot: leaves[depth],
+                inverted: false,
+            },
+            ebr,
+        );
+        format!("({read} ? {high} : {low})")
+    }
+    branch(&LineFn::Lut(init, *t), &leaves, 0, 0, ebr)
+}
