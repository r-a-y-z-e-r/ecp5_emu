# Cargo build output. Also holds research caches, native probe binaries
# (trellis_image_reader etc.) and raw fixture traces — not versioned here.
/target/

# Python bytecode
__pycache__/
*.py[cod]

# IDE project files are machine-local.
/.idea/

# macOS
.DS_Store

# Generated by tools (caches, layer plots, textures, .blend, renders) — rebuildable.
/out/

# Machine-local scripts and settings.
/tools/local/
/tools/rserv.sh

# Agent instructions and agent workspaces stay local.
/CLAUDE.md
/.claude/

/examples/**/build/
