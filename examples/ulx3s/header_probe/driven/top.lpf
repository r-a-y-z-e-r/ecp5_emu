IOBUF PORT "gn[2]" PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "gp_pwm[2]" SITE "A9";
IOBUF PORT "gp_pwm[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
