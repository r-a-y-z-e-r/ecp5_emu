# LPF (Lattice Preference File) maps top-level ports to package pins and sets I/O.
# LOCATE COMP "port" SITE "ball"; connects a port to a physical package ball.
# A ball name is a CABGA381 coordinate: row letter plus column number,
# as seen on the package underside; for example, G2 is row G, column 2.
# IOBUF PORT "port" IO_TYPE=... PULLMODE=... DRIVE=...;
# IO_TYPE selects the electrical standard: LVCMOS33 means 3.3 V on ULX3S.
# PULLMODE selects a weak internal pull: UP to 1, DOWN to 0, NONE disables it.
# DRIVE sets output drive strength in mA; it does not set an input's level.
# FREQUENCY PORT "clk_25mhz" 25 MHZ; tells timing analysis the clock rate.
# Bus bits are separate ports, written in quotes, for example "led[0]".
# Ball names: Radiona ULX3S, EMARD's doc/constraints/ulx3s_v20.lpf.
# Pin-constraint licence: assets/ulx3s/LICENSE.md.

# 25 MHz oscillator
FREQUENCY PORT "clk_25mhz" 25.000 MHZ;
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF PORT "clk_25mhz" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# FTDI UART
LOCATE COMP "ftdi_rxd" SITE "L4";
IOBUF PORT "ftdi_rxd" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# LEDs D0..D7
LOCATE COMP "led[0]" SITE "B2";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[1]" SITE "C2";
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[2]" SITE "C1";
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[3]" SITE "D2";
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[4]" SITE "D1";
IOBUF PORT "led[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[5]" SITE "E2";
IOBUF PORT "led[5]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[6]" SITE "E1";
IOBUF PORT "led[6]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "led[7]" SITE "H3";
IOBUF PORT "led[7]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# SDRAM clock and control
LOCATE COMP "sdram_clk" SITE "F19";
IOBUF PORT "sdram_clk" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_cke" SITE "F20";
IOBUF PORT "sdram_cke" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_csn" SITE "P20";
IOBUF PORT "sdram_csn" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_wen" SITE "T20";
IOBUF PORT "sdram_wen" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_rasn" SITE "R20";
IOBUF PORT "sdram_rasn" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_casn" SITE "T19";
IOBUF PORT "sdram_casn" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# SDRAM bank address
LOCATE COMP "sdram_ba[0]" SITE "P19";
IOBUF PORT "sdram_ba[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_ba[1]" SITE "N20";
IOBUF PORT "sdram_ba[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# SDRAM byte masks
LOCATE COMP "sdram_dqm[0]" SITE "U19";
IOBUF PORT "sdram_dqm[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_dqm[1]" SITE "E20";
IOBUF PORT "sdram_dqm[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# SDRAM address
LOCATE COMP "sdram_a[0]" SITE "M20";
IOBUF PORT "sdram_a[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[1]" SITE "M19";
IOBUF PORT "sdram_a[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[2]" SITE "L20";
IOBUF PORT "sdram_a[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[3]" SITE "L19";
IOBUF PORT "sdram_a[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[4]" SITE "K20";
IOBUF PORT "sdram_a[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[5]" SITE "K19";
IOBUF PORT "sdram_a[5]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[6]" SITE "K18";
IOBUF PORT "sdram_a[6]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[7]" SITE "J20";
IOBUF PORT "sdram_a[7]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[8]" SITE "J19";
IOBUF PORT "sdram_a[8]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[9]" SITE "H20";
IOBUF PORT "sdram_a[9]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[10]" SITE "N19";
IOBUF PORT "sdram_a[10]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[11]" SITE "G20";
IOBUF PORT "sdram_a[11]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_a[12]" SITE "G19";
IOBUF PORT "sdram_a[12]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# SDRAM data
LOCATE COMP "sdram_d[0]" SITE "J16";
IOBUF PORT "sdram_d[0]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[1]" SITE "L18";
IOBUF PORT "sdram_d[1]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[2]" SITE "M18";
IOBUF PORT "sdram_d[2]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[3]" SITE "N18";
IOBUF PORT "sdram_d[3]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[4]" SITE "P18";
IOBUF PORT "sdram_d[4]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[5]" SITE "T18";
IOBUF PORT "sdram_d[5]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[6]" SITE "T17";
IOBUF PORT "sdram_d[6]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[7]" SITE "U20";
IOBUF PORT "sdram_d[7]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[8]" SITE "E19";
IOBUF PORT "sdram_d[8]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[9]" SITE "D20";
IOBUF PORT "sdram_d[9]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[10]" SITE "D19";
IOBUF PORT "sdram_d[10]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[11]" SITE "C20";
IOBUF PORT "sdram_d[11]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[12]" SITE "E18";
IOBUF PORT "sdram_d[12]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[13]" SITE "F18";
IOBUF PORT "sdram_d[13]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[14]" SITE "J18";
IOBUF PORT "sdram_d[14]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sdram_d[15]" SITE "J17";
IOBUF PORT "sdram_d[15]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

# Buttons PWR, FIRE1, FIRE2, UP, DOWN, LEFT, RIGHT
LOCATE COMP "btn[0]" SITE "D6";
LOCATE COMP "btn[1]" SITE "R1";
LOCATE COMP "btn[2]" SITE "T1";
LOCATE COMP "btn[3]" SITE "R18";
LOCATE COMP "btn[4]" SITE "V1";
LOCATE COMP "btn[5]" SITE "U1";
LOCATE COMP "btn[6]" SITE "H16";
IOBUF PORT "btn[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

# FTDI UART
LOCATE COMP "ftdi_txd" SITE "M1";
IOBUF PORT "ftdi_txd" PULLMODE=UP IO_TYPE=LVCMOS33;
